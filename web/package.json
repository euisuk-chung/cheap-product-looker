{
  "name": "cheap-product-looker-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,admin -c green,blue \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:admin": "tsx watch server/index.ts",
    "build": "npm run data:validate && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src server --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "data:validate": "tsx server/validate.ts",
    "data:rebuild": "tsx server/rebuild-snapshot.ts",
    "data:products:import": "tsx server/import-products-csv.ts",
    "data:import": "tsx server/import-run.ts",
    "data:publish-status": "tsx server/update-publish-status.ts"
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.8.3",
    "express": "^5.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.2"
  },
  "type": "module"
}
